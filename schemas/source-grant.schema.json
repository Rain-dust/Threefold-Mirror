{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "search",
          "recent",
          "resolve"
        ]
      }
    },
    "permission": {
      "type": "object",
      "properties": {
        "read": {
          "type": "boolean"
        },
        "search": {
          "type": "boolean"
        },
        "write": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "read",
        "search",
        "write"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "include": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "from": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "include",
        "exclude",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "consent": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "granted",
            "revoked"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        }
      },
      "required": [
        "status",
        "statement",
        "recorded_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "source_id",
    "capabilities",
    "permission",
    "scope",
    "consent"
  ],
  "additionalProperties": false
}
